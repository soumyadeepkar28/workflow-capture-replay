{
  "manifest_version": 3,
  "name": "Workflow Replay Recorder",
  "description": "Records bounded browser actions for the local Helpdesk demonstration.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Workflow Replay Recorder"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*"]
  }
}